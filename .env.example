# Copy this file to `.env` and paste YOUR OWN key. Never commit `.env`.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / macOS:    cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-paste-your-own-key-here

# Model. Leave as-is unless you know why you're changing it.
COSMIC_MODEL=claude-sonnet-5

# How the LLM client behaves:
#   live   - call the API every time (normal development)
#   record - call the API AND save the response to fixtures/ (do this before demo day)
#   replay - never call the API, serve saved fixtures only (demo-day insurance, works offline)
COSMIC_LLM_MODE=live

# Only set this if you are pointing at an internal gateway instead of the public API.
# ANTHROPIC_BASE_URL=
