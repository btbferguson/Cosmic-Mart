# Copy this file to `.env` and fill in your own keys. Never commit `.env`.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / macOS:    cp .env.example .env
#
# You need BOTH providers to run the full system:
#   Agents 1 and 2 (fact checker, customer resolution)  ->  Anthropic
#   Agent 3        (deadstock zero)                     ->  OpenRouter
#
# `npm run check` tells you exactly what is missing or misconfigured.


# ====================================================================
# ANTHROPIC — required for Agents 1 and 2
# ====================================================================

# Two kinds of key work here:
#   voc-...     Udacity / Vocareum course key (what the team is using)
#   sk-ant-...  a direct key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=voc-paste-your-own-key-here

# REQUIRED for voc- keys. Vocareum keys are rejected by api.anthropic.com,
# so the endpoint must point at Vocareum:
#   Vocareum / Udacity  ->  https://claude.vocareum.com
#   direct sk-ant- key  ->  comment this line out
#
# Use COSMIC_ANTHROPIC_BASE_URL, NOT ANTHROPIC_BASE_URL. Some machines have
# ANTHROPIC_BASE_URL set globally (pointing at api.anthropic.com), and Node's
# --env-file does NOT overwrite variables that already exist in the
# environment. That silently overrides this file and produces a confusing
# 401 "invalid x-api-key". Nothing else sets COSMIC_ANTHROPIC_BASE_URL, so it
# always wins. `npm run check` fails loudly if a voc- key points somewhere else.
COSMIC_ANTHROPIC_BASE_URL=https://claude.vocareum.com

# Model for Agents 1 and 2. Note: claude-sonnet-5 rejects the `temperature`
# parameter outright; src/llm.js notices and drops it automatically.
COSMIC_MODEL=claude-sonnet-5


# ====================================================================
# OPENROUTER — required for Agent 3
# ====================================================================

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-paste-your-own-key-here

# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Reasoning effort. GLM 5.3 Flash reasons on every call and the provider
# refuses to let you disable it, so this is a floor, not an off switch.
# One of: none | minimal | low | medium | high | max
OPENROUTER_REASONING=low

# Provider routing for Agent 3, in preference order. Defaults to
# Parasail,Together inside src/openrouter.js — only set this to override.
#
# This matters more than any other setting in this file. OpenRouter serves GLM
# from a dozen endpoints and they do not behave the same. Measured on identical
# work at reasoning effort 'low':
#   Parasail    0.8s      56 characters of reasoning
#   Together    3.4s      79 characters
#   Wafer     237.0s  13,529 characters   <- what default routing picked
# Wafer ignores the effort setting and reasons until it hits the token ceiling.
# Leave this alone unless a provider starts rate-limiting you.
# OPENROUTER_PROVIDERS=Parasail,Together


# ====================================================================
# SHARED
# ====================================================================

# How both LLM clients behave:
#   live   - call the API every time (normal development)
#   record - call the API AND save the response into fixtures/, so the same run
#            can be replayed later. Do this before demo day.
#   replay - never call the API, serve saved fixtures only. Works offline with
#            no keys at all. Demo-day insurance against conference wifi.
COSMIC_LLM_MODE=live
